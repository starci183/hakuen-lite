{
  "name": "hakuen-lite",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/typeorm": "11.0.3",
    "@starci/auth": "0.6.0",
    "@starci/common": "1.0.1",
    "@starci/mail": "0.2.0",
    "@starci/nest-kit": "0.2.2",
    "@starci/object-storage": "0.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typeorm": "0.3.31",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.5",
    "@starci/eslint-canon-be": "3.25.0",
    "@starci/jest-preset": "2.9.1",
    "@starci/prettier-config": "1.1.0",
    "@starci/tsconfig": "2.1.1",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "starci-harness": "1.1.0-alpha.120",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "@xyflow/react": "12.11.6",
    "dayjs": "1.11.21",
    "multer": "2.5.0",
    "react-aria-components": "1.21.1",
    "zod": "4.6.7",
    "zustand": "5.0.12"
  },
  "scripts": {
    "prepare": "husky",
    "dev:be": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/api/src/main.ts",
    "start:api": "node be/dist/apps/api/src/main.js",
    "build:modules": "turbo run build --filter=./packages/*",
    "docker:build": "npm run docker:build:api",
    "docker:build:api": "docker build -f be/apps/api/Dockerfile -t hakuen-lite/api:dev .",
    "build:be": "npm run build:modules --silent && cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "npm run build:modules --silent && tsc -p be/tsconfig.json && turbo run typecheck",
    "lint": "npm run build:modules --silent && starci app check --gate lint",
    "lint:fix": "npm run build:modules --silent && starci app check --gate lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc -p be/src/tests/tsconfig.json",
    "test": "npm run build:modules --silent && cd be && jest --selectProjects unit --coverage",
    "test:integration": "npm run typecheck:tests && cd be && jest --selectProjects integration",
    "db:image": "docker build --tag hakuen-lite-db:local .starcistacks/images/db",
    "db:create": "npm run db:image && docker create --name hakuen-lite-dev-db -p 127.0.0.1:54322:5432 -e POSTGRES_HOST_AUTH_METHOD=trust -v hakuen-lite-dev-db-data:/var/lib/postgresql/data hakuen-lite-db:local",
    "db:start": "docker start hakuen-lite-dev-db",
    "db:stop": "docker stop hakuen-lite-dev-db",
    "db:reset": "docker rm -f hakuen-lite-dev-db && docker volume rm hakuen-lite-dev-db-data && npm run db:create && npm run db:start",
    "db:new": "starci app db new",
    "db:push": "starci app db migrate --db-url-env DATABASE_URL --execute",
    "db:plan": "starci app db migrate --db-url-env DATABASE_URL",
    "db:dump": "starci app db dump --db-url-env DATABASE_URL --out ../hakuen-lite-db-backups",
    "db:lint": "starci app check --gate db",
    "contract:emit": "starci app emit"
  }
}
